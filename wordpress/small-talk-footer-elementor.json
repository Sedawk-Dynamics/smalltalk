              "widgetType": "html",
              "settings": {
                "html": "<style>\n/* ============================================================\n   15. FOOTER — exact Next.js footer (markup in footer.html,\n       pasted into one full-width Custom HTML footer widget)\n   ============================================================ */\n.footer-container {\n\tpadding: 0 !important;\n}\n.st-footer {\n\tfont-family: \"Manrope\", system-ui, sans-serif;\n\tcolor: rgba(255, 255, 255, 0.55);\n}\n.st-footer a {\n\tcolor: rgba(255, 255, 255, 0.55) !important;\n\ttext-decoration: none;\n\ttransition: color 0.25s ease;\n}\n.st-footer a:hover {\n\tcolor: #fff !important;\n}\n\n/* Motif divider — thin lines + indigo tee icon at 30% opacity */\n.st-footer-divider {\n\tdisplay: flex;\n\talign-items: center;\n\tgap: 16px;\n\tpadding: 24px;\n\topacity: 0.3;\n}\n.st-footer-divider span {\n\theight: 1px;\n\tflex: 1;\n\tbackground: rgba(255, 255, 255, 0.2);\n}\n.st-footer-divider svg {\n\twidth: 24px;\n\theight: 24px;\n\tcolor: #5b5bf0;\n}\n\n/* Column grid — 1.5 / 1 / 1 / 1 / 1 / 1.3, like the Next.js footer */\n.st-footer-grid {\n\tdisplay: grid;\n\tgrid-template-columns: 1.5fr 1fr 1fr 1fr 1fr 1.3fr;\n\tgap: 48px 32px;\n\tmax-width: 1280px;\n\tmargin: 0 auto;\n\tpadding: 24px 24px 48px;\n}\n@media (max-width: 1024px) {\n\t.st-footer-grid {\n\t\tgrid-template-columns: 1fr 1fr 1fr;\n\t}\n}\n@media (max-width: 640px) {\n\t.st-footer-grid {\n\t\tgrid-template-columns: 1fr 1fr;\n\t}\n}\n\n.st-footer-logo {\n\theight: 40px;\n\twidth: auto;\n\tmargin-bottom: 20px;\n}\n.st-footer-brand p {\n\tmax-width: 280px;\n\tfont-size: 14px;\n\tline-height: 1.6;\n\tcolor: rgba(255, 255, 255, 0.6);\n}\n\n.st-footer-grid h4 {\n\tfont-family: \"Manrope\", system-ui, sans-serif !important;\n\tfont-size: 14px !important;\n\tfont-weight: 600;\n\tletter-spacing: 0.05em;\n\ttext-transform: uppercase;\n\tcolor: rgba(255, 255, 255, 0.9) !important;\n\tmargin: 0 0 16px;\n}\n.st-footer-grid ul {\n\tlist-style: none;\n\tmargin: 0;\n\tpadding: 0;\n}\n.st-footer-grid ul li {\n\tmargin-bottom: 10px;\n\tfont-size: 14px;\n\tlist-style: none;\n}\n\n/* Contact column — indigo icons */\n.st-contact li {\n\tdisplay: flex;\n\tgap: 10px;\n\talign-items: flex-start;\n\tmargin-bottom: 12px;\n}\n.st-contact svg {\n\twidth: 16px;\n\theight: 16px;\n\tflex-shrink: 0;\n\tmargin-top: 2px;\n\tcolor: #5b5bf0;\n\tstroke: currentColor;\n\tfill: none;\n\tstroke-width: 2;\n\tstroke-linecap: round;\n\tstroke-linejoin: round;\n}\n.st-hours {\n\tfont-size: 12px;\n\tcolor: rgba(255, 255, 255, 0.4);\n}\n\n/* Social circles — border, fill indigo on hover */\n.st-socials {\n\tdisplay: flex;\n\tgap: 8px;\n\tmargin-top: 20px;\n}\n.st-socials a {\n\tdisplay: flex;\n\talign-items: center;\n\tjustify-content: center;\n\twidth: 36px;\n\theight: 36px;\n\tborder: 1px solid rgba(255, 255, 255, 0.15);\n\tborder-radius: 999px;\n\tcolor: rgba(255, 255, 255, 0.7) !important;\n\ttransition: all 0.3s ease;\n}\n.st-socials a:hover {\n\tborder-color: #5b5bf0;\n\tbackground: #5b5bf0;\n\tcolor: #fff !important;\n}\n.st-socials svg {\n\twidth: 16px;\n\theight: 16px;\n\tstroke: currentColor;\n\tfill: none;\n\tstroke-width: 2;\n\tstroke-linecap: round;\n\tstroke-linejoin: round;\n}\n\n/* Bottom bar — © + payment chips + legal links */\n.st-footer-bottom {\n\tborder-top: 1px solid rgba(255, 255, 255, 0.1);\n}\n.st-footer-bottom-inner {\n\tmax-width: 1280px;\n\tmargin: 0 auto;\n\tdisplay: flex;\n\tflex-wrap: wrap;\n\talign-items: center;\n\tjustify-content: space-between;\n\tgap: 16px;\n\tpadding: 24px;\n\tfont-size: 12px;\n\tcolor: rgba(255, 255, 255, 0.45);\n}\n.st-footer-bottom-inner .st-gstin {\n\tcolor: rgba(255, 255, 255, 0.3);\n}\n.st-pay {\n\tdisplay: flex;\n\tflex-wrap: wrap;\n\talign-items: center;\n\tgap: 8px;\n}\n.st-pay span {\n\tdisplay: flex;\n\talign-items: center;\n\tjustify-content: center;\n\theight: 28px;\n\twidth: 44px;\n\tborder-radius: 6px;\n\tbackground: #fff;\n\tbox-shadow: 0 1px 2px rgba(0, 0, 0, 0.1);\n}\n.st-legal-links {\n\tdisplay: flex;\n\tgap: 16px;\n}\n\n/* WhatsApp floating button */\n.st-whatsapp {\n\tposition: fixed;\n\tright: 24px;\n\tbottom: 24px;\n\tz-index: 90;\n\tdisplay: flex;\n\talign-items: center;\n\tjustify-content: center;\n\twidth: 56px;\n\theight: 56px;\n\tborder-radius: 999px;\n\tbackground: #25d366;\n\tbox-shadow: 0 10px 30px -8px rgba(37, 211, 102, 0.6);\n\ttransition: transform 0.3s ease;\n}\n.st-whatsapp:hover {\n\ttransform: scale(1.08);\n}\n.st-whatsapp svg {\n\twidth: 28px;\n\theight: 28px;\n\tfill: #fff;\n}\n/* Keep WoodMart's scroll-to-top above the WhatsApp button */\n.scrollToTop {\n\tbottom: 96px !important;\n\tright: 24px !important;\n}\n\n</style>\n<div class=\"st-footer\">\n\n  <!-- Brand motif divider -->\n  <div class=\"st-footer-divider\" aria-hidden=\"true\">\n    <span></span>\n    <svg viewBox=\"0 0 64 64\" fill=\"none\"><path d=\"M22 8 L12 14 L7 26 L16 30 L18 24 L18 54 A2 2 0 0 0 20 56 L44 56 A2 2 0 0 0 46 54 L46 24 L48 30 L57 26 L52 14 L42 8 C40 14 34 16 32 16 C30 16 24 14 22 8 Z\" fill=\"currentColor\"/></svg>\n    <span></span>\n  </div>\n\n  <div class=\"st-footer-grid\">\n\n    <!-- Col 1 — brand -->\n    <div class=\"st-footer-brand\">\n      <img src=\"https://staging.smalltalks.sedawk.cloud/wp-content/uploads/2026/07/logo-white-scaled.png\" alt=\"The Small Talk Store\" class=\"st-footer-logo\" loading=\"lazy\">\n      <p>Premium everyday apparel — honest pricing, no compromise.</p>\n    </div>\n\n    <!-- Col 2 — Shop (this site) -->\n    <div>\n      <h4>Shop</h4>\n      <ul>\n        <li><a href=\"/product-category/tees/\">Tees</a></li>\n        <li><a href=\"/product-category/polos/\">Polos</a></li>\n        <li><a href=\"/product-category/hoodies/\">Hoodies</a></li>\n        <li><a href=\"/product-category/pullover/\">Pullover</a></li>\n        <li><a href=\"/product-category/joggers/\">Joggers</a></li>\n        <li><a href=\"/product-category/kids/\">Kids</a></li>\n        <li><a href=\"/shop/\">All Products</a></li>\n      </ul>\n    </div>\n\n    <!-- Col 3 — Company (main site) -->\n    <div>\n      <h4>Company</h4>\n      <ul>\n        <li><a href=\"https://thesmalltalkstore.com/about\">About</a></li>\n        <li><a href=\"https://thesmalltalkstore.com/contact\">Contact</a></li>\n      </ul>\n    </div>\n\n    <!-- Col 4 — Support (main site) -->\n    <div>\n      <h4>Support</h4>\n      <ul>\n        <li><a href=\"https://thesmalltalkstore.com/support/shipping\">Shipping</a></li>\n        <li><a href=\"https://thesmalltalkstore.com/support/returns\">Returns</a></li>\n        <li><a href=\"https://thesmalltalkstore.com/support/faq\">FAQ</a></li>\n      </ul>\n    </div>\n\n    <!-- Col 5 — Legal (main site) -->\n    <div>\n      <h4>Legal</h4>\n      <ul>\n        <li><a href=\"https://thesmalltalkstore.com/terms\">Terms &amp; Conditions</a></li>\n        <li><a href=\"https://thesmalltalkstore.com/privacy\">Privacy Policy</a></li>\n        <li><a href=\"https://thesmalltalkstore.com/refund\">Refund &amp; Cancellation</a></li>\n      </ul>\n    </div>\n\n    <!-- Col 6 — Contact -->\n    <div>\n      <h4>Contact</h4>\n      <ul class=\"st-contact\">\n        <li>\n          <svg viewBox=\"0 0 24 24\"><path d=\"M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z\"/><circle cx=\"12\" cy=\"10\" r=\"3\"/></svg>\n          <span>C-182 Pushpanjali Enclave, Pitampura, New Delhi 110034</span>\n        </li>\n        <li>\n          <svg viewBox=\"0 0 24 24\"><path d=\"M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z\"/></svg>\n          <a href=\"tel:+918595382034\">+91 8595382034</a>\n        </li>\n        <li>\n          <svg viewBox=\"0 0 24 24\"><rect x=\"2\" y=\"4\" width=\"20\" height=\"16\" rx=\"2\"/><path d=\"m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7\"/></svg>\n          <a href=\"mailto:info@thesmalltalkstore.com\">info@thesmalltalkstore.com</a>\n        </li>\n        <li class=\"st-hours\">Hours: 9:00 AM – 5:00 PM</li>\n      </ul>\n\n      <div class=\"st-socials\">\n        <a href=\"https://instagram.com\" target=\"_blank\" rel=\"noopener noreferrer\" aria-label=\"Instagram\">\n          <svg viewBox=\"0 0 24 24\"><rect x=\"2\" y=\"2\" width=\"20\" height=\"20\" rx=\"5\"/><path d=\"M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z\"/><line x1=\"17.5\" y1=\"6.5\" x2=\"17.51\" y2=\"6.5\"/></svg>\n        </a>\n        <a href=\"https://facebook.com\" target=\"_blank\" rel=\"noopener noreferrer\" aria-label=\"Facebook\">\n          <svg viewBox=\"0 0 24 24\"><path d=\"M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z\"/></svg>\n        </a>\n        <a href=\"https://twitter.com\" target=\"_blank\" rel=\"noopener noreferrer\" aria-label=\"Twitter\">\n          <svg viewBox=\"0 0 24 24\"><path d=\"M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z\"/></svg>\n        </a>\n        <a href=\"https://youtube.com\" target=\"_blank\" rel=\"noopener noreferrer\" aria-label=\"YouTube\">\n          <svg viewBox=\"0 0 24 24\"><path d=\"M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-1.92 29 29 0 0 0 .46-5.33 29 29 0 0 0-.46-5.33z\"/><polygon points=\"9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02\"/></svg>\n        </a>\n      </div>\n    </div>\n  </div>\n\n  <!-- Copyright + payment badges + legal links -->\n  <div class=\"st-footer-bottom\">\n    <div class=\"st-footer-bottom-inner\">\n      <p>© 2026 Small Talk Garment LLP. All rights reserved. <span class=\"st-gstin\">GSTIN: 07AFXFS8211B1ZS</span></p>\n\n      <div class=\"st-pay\" aria-label=\"Accepted payment methods\">\n        <span title=\"Visa\"><svg viewBox=\"0 0 48 16\" style=\"height:12px\"><text x=\"24\" y=\"13\" text-anchor=\"middle\" font-family=\"Arial, Helvetica, sans-serif\" font-weight=\"700\" font-style=\"italic\" font-size=\"15\" letter-spacing=\"0.5\" fill=\"#1A1F71\">VISA</text></svg></span>\n        <span title=\"Mastercard\"><svg viewBox=\"0 0 40 24\" style=\"height:16px\"><circle cx=\"15\" cy=\"12\" r=\"8\" fill=\"#EB001B\"/><circle cx=\"25\" cy=\"12\" r=\"8\" fill=\"#F79E1B\"/><ellipse cx=\"20\" cy=\"12\" rx=\"3\" ry=\"6\" fill=\"#FF5F00\"/></svg></span>\n        <span title=\"RuPay\"><svg viewBox=\"0 0 52 16\" style=\"height:12px\"><text x=\"0\" y=\"13\" font-family=\"Arial, Helvetica, sans-serif\" font-weight=\"800\" font-style=\"italic\" font-size=\"14\"><tspan fill=\"#1B458F\">Ru</tspan><tspan fill=\"#F37021\">Pay</tspan></text></svg></span>\n        <span title=\"UPI\"><svg viewBox=\"0 0 34 16\" style=\"height:14px\"><text x=\"0\" y=\"13\" font-family=\"Arial, Helvetica, sans-serif\" font-weight=\"800\" font-style=\"italic\" font-size=\"14\"><tspan fill=\"#F37021\">U</tspan><tspan fill=\"#0C8A3E\">P</tspan><tspan fill=\"#1B458F\">I</tspan></text></svg></span>\n        <span title=\"American Express\"><svg viewBox=\"0 0 44 24\" style=\"height:20px\"><rect width=\"44\" height=\"24\" rx=\"3\" fill=\"#006FCF\"/><text x=\"22\" y=\"15\" text-anchor=\"middle\" font-family=\"Arial, Helvetica, sans-serif\" font-weight=\"700\" font-size=\"9\" letter-spacing=\"0.5\" fill=\"#ffffff\">AMEX</text></svg></span>\n      </div>\n\n      <div class=\"st-legal-links\">\n        <a href=\"https://thesmalltalkstore.com/terms\">Terms</a>\n        <a href=\"https://thesmalltalkstore.com/privacy\">Privacy</a>\n        <a href=\"https://thesmalltalkstore.com/refund\">Refund</a>\n      </div>\n    </div>\n  </div>\n</div>\n\n<!-- WhatsApp floating button -->\n<a class=\"st-whatsapp\" href=\"https://wa.me/918595382034\" target=\"_blank\" rel=\"noopener noreferrer\" aria-label=\"Chat on WhatsApp\">\n 